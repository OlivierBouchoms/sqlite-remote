{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Cors": {
    "AllowedHeaders": [
      "Content-Type"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "PATCH"
    ],
    "AllowedOrigins": [
      "http://localhost:4000",
      "https://localhost:4000",
      "http://localhost:4444",
      "https://localhost:4444",
      "http://localhost:7777",
      "https://localhost:7777"
    ]
  },
  "Ssh": {
    "ConfigPath": "/app/.ssh/config"
  },
  "Network": {
    "HostGateway": "host.docker.internal",
    "TranslateLoopbackAddress": true
  },
  "AllowedHosts": "*"
}
